@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@RENDER_GRAPH_ENABLE_VULKAN@)
    find_dependency(Vulkan)
    find_dependency(VulkanMemoryAllocator CONFIG)
endif()

if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/render_graphTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/render_graphTargets.cmake")
endif()
